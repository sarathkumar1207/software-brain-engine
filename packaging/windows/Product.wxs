<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="Software Brain Engine"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="Software Brain Engine contributors"
    UpgradeCode="2FBA4AA6-D0D6-4E7B-855B-9EB9F14A7489">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Description="Software Brain Engine CLI"
      Comments="Installs the sbe command line tool." />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Software Brain Engine is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Software Brain Engine">
          <Component Id="SbeExe" Guid="944772B6-F19E-4C04-9EDA-2DC50F572309">
            <File
              Id="SbeExeFile"
              Source="$(var.SbeExePath)"
              KeyPath="yes" />
            <Environment
              Id="AddInstallFolderToPath"
              Name="PATH"
              Value="[INSTALLFOLDER]"
              Permanent="no"
              Part="last"
              Action="set"
              System="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="Software Brain Engine" Level="1">
      <ComponentRef Id="SbeExe" />
    </Feature>
  </Product>
</Wix>
